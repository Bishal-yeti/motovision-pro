<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mv_background">

    <!-- Live Camera Viewfinder -->
    <androidx.camera.view.PreviewView
        android:id="@+id/viewFinder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:scaleType="fillCenter" />

    <!-- Focus Peaking Overlay -->
    <com.motovision.pro.ui.view.FocusPeakingOverlay
        android:id="@+id/focusPeakingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top Action Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/mv_scrim"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/appLogoText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MOTOVISION PRO"
            android:textColor="@color/mv_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Quick B&W Toggle Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnQuickBw"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:text="B&amp;W"
            android:textColor="@color/mv_text_secondary"
            android:textSize="12sp"
            app:backgroundTint="@color/mv_surface_variant"
            app:cornerRadius="18dp" />

        <!-- Profile Selection Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnProfile"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="@string/profile_balanced"
            android:textColor="@color/mv_text_primary"
            android:textSize="12sp"
            app:backgroundTint="@color/mv_surface_variant"
            app:cornerRadius="18dp" />

        <ImageButton
            android:id="@+id/btnInfo"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Info"
            android:src="@android:drawable/ic_dialog_info"
            app:tint="@color/mv_text_primary" />
    </LinearLayout>

    <!-- Real-time Live Histogram Overlay -->
    <com.motovision.pro.ui.view.HistogramView
        android:id="@+id/histogramView"
        android:layout_width="120dp"
        android:layout_height="64dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar" />

    <!-- Status Toast / Processing Banner -->
    <TextView
        android:id="@+id/txtStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_status_pill"
        android:paddingHorizontal="16dp"
        android:paddingVertical="6dp"
        android:textColor="@color/mv_text_primary"
        android:textSize="12sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        tools:text="Processing Natural profile…"
        tools:visibility="visible" />

    <!-- Video Recording Timer Banner -->
    <LinearLayout
        android:id="@+id/recordingTimerContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_status_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        tools:visibility="visible">

        <View
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_rec_dot" />

        <TextView
            android:id="@+id/txtRecordingTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textColor="@color/mv_text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Video Settings Quick Bar (FHD/HD, High/Std Bitrate, EIS) -->
    <LinearLayout
        android:id="@+id/videoControlPanel"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_lens_pill"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/zoomControlBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVideoResolution"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="1080p FHD"
            android:textColor="@color/mv_primary"
            android:textSize="11sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVideoBitrate"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="High (38M)"
            android:textColor="@color/mv_primary"
            android:textSize="11sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVideoEis"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="EIS ON"
            android:textColor="@color/mv_primary"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Pro Mode Control Panel -->
    <LinearLayout
        android:id="@+id/proControlPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/mv_scrim"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/zoomControlBar"
        tools:visibility="visible">

        <!-- Pro Sliders & Metric Values -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtProIsoLabel"
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:text="ISO Auto"
                android:textColor="@color/mv_primary"
                android:textSize="11sp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderIso"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:valueFrom="0"
                android:valueTo="3200"
                android:stepSize="100"
                android:value="0" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtProShutterLabel"
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:text="S Auto"
                android:textColor="@color/mv_primary"
                android:textSize="11sp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderShutter"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:valueFrom="0"
                android:valueTo="1000"
                android:stepSize="10"
                android:value="0" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtProFocusLabel"
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:text="MF Auto"
                android:textColor="@color/mv_primary"
                android:textSize="11sp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderFocus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:valueFrom="0"
                android:valueTo="10"
                android:stepSize="0.5"
                android:value="0" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtProEvLabel"
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:text="EV 0.0"
                android:textColor="@color/mv_primary"
                android:textSize="11sp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderEv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:valueFrom="-2.0"
                android:valueTo="2.0"
                android:stepSize="0.33"
                android:value="0.0" />
        </LinearLayout>

        <!-- Pro Quick Toggles: WB, Peaking, RAW -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp"
            android:paddingTop="4dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnProWb"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="WB Auto"
                android:textColor="@color/mv_text_primary"
                android:textSize="10sp"
                app:cornerRadius="17dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTogglePeaking"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="Peaking ON"
                android:textColor="@color/mv_primary"
                android:textSize="10sp"
                app:cornerRadius="17dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToggleRaw"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:text="RAW OFF"
                android:textColor="@color/mv_text_secondary"
                android:textSize="10sp"
                app:cornerRadius="17dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Floating Digital Zoom Indicator -->
    <TextView
        android:id="@+id/txtZoomIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_status_pill"
        android:paddingHorizontal="12dp"
        android:paddingVertical="3dp"
        android:text="1.0x"
        android:textColor="@color/mv_primary"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/zoomControlBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:visibility="visible" />

    <!-- Quick Digital Zoom Controls (1x, 2x, 4x) -->
    <LinearLayout
        android:id="@+id/zoomControlBar"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_lens_pill"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp"
        app:layout_constraintBottom_toTopOf="@id/lensSelectorBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/btnZoom1x"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_lens_active"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:text="1x"
            android:textColor="@color/mv_primary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnZoom2x"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:text="2x"
            android:textColor="@color/mv_text_secondary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnZoom4x"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:text="4x"
            android:textColor="@color/mv_text_secondary"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Lens Selection Chips (0.6x, 1x, Macro, Front) -->
    <LinearLayout
        android:id="@+id/lensSelectorBar"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_lens_pill"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp"
        app:layout_constraintBottom_toTopOf="@id/modeSelectorScrollView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/btnLensWide"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="0.6x"
            android:textColor="@color/mv_text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnLensMain"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_lens_active"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="1x"
            android:textColor="@color/mv_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnLensMacro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="Macro"
            android:textColor="@color/mv_text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnLensFront"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="Front"
            android:textColor="@color/mv_text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Mode Selector Scroll Carousel -->
    <HorizontalScrollView
        android:id="@+id/modeSelectorScrollView"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginBottom="16dp"
        android:fadeScrollbars="false"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/bottomControlBar">

        <LinearLayout
            android:id="@+id/modeSelectorContainer"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="32dp">

            <TextView
                android:id="@+id/modeNight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:text="@string/mode_night"
                android:textColor="@color/mv_text_secondary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/modeHdr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:text="@string/mode_hdr"
                android:textColor="@color/mv_text_secondary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/modePhoto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:text="@string/mode_photo"
                android:textColor="@color/mv_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/modePortrait"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:text="@string/mode_portrait"
                android:textColor="@color/mv_text_secondary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/modePro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:text="@string/mode_pro"
                android:textColor="@color/mv_text_secondary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/modeVideo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:text="@string/mode_video"
                android:textColor="@color/mv_text_secondary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Bottom Shutter Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottomControlBar"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:background="@color/mv_scrim"
        android:paddingHorizontal="24dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Gallery / Comparison Thumbnail -->
        <ImageView
            android:id="@+id/btnGalleryThumbnail"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_thumbnail_frame"
            android:contentDescription="Gallery &amp; Compare"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_menu_gallery"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Main Interactive Shutter Button -->
        <com.motovision.pro.ui.view.ShutterButton
            android:id="@+id/btnShutter"
            android:layout_width="76dp"
            android:layout_height="76dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Camera Switch (Front/Back) -->
        <ImageButton
            android:id="@+id/btnSwitchCamera"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Switch Camera"
            android:src="@android:drawable/ic_menu_rotate"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/mv_text_primary" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Fullscreen Before/After Comparison Overlay (Hidden by default) -->
    <FrameLayout
        android:id="@+id/comparisonContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/mv_background"
        android:visibility="gone">

        <com.motovision.pro.ui.view.ComparisonView
            android:id="@+id/comparisonView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ImageButton
            android:id="@+id/btnCloseComparison"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="top|end"
            android:layout_margin="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="@color/mv_text_primary" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
